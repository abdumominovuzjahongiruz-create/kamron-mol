# ---- ISHTOP.UZ Environment Variables -----------------------------------------
# Copy this file to `.env` and fill in the values.

# Public Supabase / API URL
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role key (Backend/Seed only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Postgres DB Connection String (Optional for setup script)
SUPABASE_DB_URL=postgres://postgres:password@host:5432/postgres
DATABASE_URL=postgres://postgres:password@host:5432/postgres

# Support Contact Configuration
VITE_TELEGRAM_PHONE=+998773879545
VITE_SUPPORT_EMAIL=support@ishtop.uz
SUPPORT_EMAIL=support@ishtop.uz
TELEGRAM_BOT_TOKEN=

# Auth Secret / JWT Secret
AUTH_SECRET=your-random-32-char-auth-secret-key-here